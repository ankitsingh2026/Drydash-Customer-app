{
  "expo": {
    "name": "DryDash",
    "slug": "DryDash",
    "version": "1.1.8",
    "orientation": "portrait",
    "backgroundColor": "#0B1F1A",
    "icon": "./assets/images/icon.png",
    "scheme": "drydash",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        // "googleMapsApiKey": "AIzaSyAT-o42Ycc63KWHxbIiGX2KgluW4BpdaYM"
        "googleMapsApiKey": "AIzaSyDGSQ0H6zb3kLpfWQgQEDWJUZdWvNyWDFY"
      },
      "bundleIdentifier": "com.drydash.customer",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.associated-domains": [
          "applinks:app.drydash.com",
          "applinks:www.drydash.com"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytm",
          "cred",
          "bhim",
          "whatsapp"
        ]
      },
      "associatedDomains": [
        "applinks:app.drydash.com",
        "applinks:www.drydash.com"
      ]
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 21,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          // "apiKey": "AIzaSyAT-o42Ycc63KWHxbIiGX2KgluW4BpdaYM"
          "apiKey": "AIzaSyDGSQ0H6zb3kLpfWQgQEDWJUZdWvNyWDFY"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B1F1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "notification": {
        "icon": "./assets/images/favicon.png",
        "color": "#0B1F1A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
  {
    "action": "VIEW",
    "autoVerify": true,
    "data": [
      {
        "scheme": "https",
        "host": "app.drydash.com",
        "pathPrefix": "/signup"
      },
      {
        "scheme": "https",
        "host": "www.drydash.com",
        "pathPrefix": "/signup"
      }
    ],
    "category": [
      "BROWSABLE",
      "DEFAULT"
    ]
  },
  {
    "action": "VIEW",
    "data": [
      {
        "scheme": "upi"
      }
    ],
    "category": [
      "BROWSABLE",
      "DEFAULT"
    ]
  },
  {
    "action": "VIEW",
    "data": [
      {
        "scheme": "drydash"
      }
    ],
    "category": [
      "BROWSABLE",
      "DEFAULT"
    ]
  }
]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F1A",
          "dark": {
            "backgroundColor": "#0B1F1A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DryDash to access your location to select pickup address"
        }
      ],
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-build-properties",
      "@lottiefiles/dotlottie-react-native/plugin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "241b6e61-b9e3-4dd5-9852-4907978a8d85"
      }
    }
  }
}